# Base de datos (docker compose levanta PostgreSQL en el puerto 5433 del host)
DATABASE_URL="postgresql://playtech:playtech@localhost:5433/playtech_intranet?schema=public"

PORT=3100
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="12h"

# URL pública del frontend (enlaces de los correos y CORS)
FRONTEND_URL="http://localhost:5173"

# Carpeta de archivos adjuntos e imágenes
UPLOAD_DIR="uploads"

# Correo. En desarrollo Mailpit captura todo en http://localhost:8025
# Si SMTP_HOST queda vacío, los correos se registran como SKIPPED en la traza.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Intranet Grupo Playtech <no-reply@grupoplaytech.com>"

# Alertas de vencimiento: horas antes del vencimiento para el aviso "por vencer"
SLA_DUE_SOON_HOURS=24
# Cada cuántas horas repetir el recordatorio de solicitud vencida
SLA_OVERDUE_REPEAT_HOURS=24
